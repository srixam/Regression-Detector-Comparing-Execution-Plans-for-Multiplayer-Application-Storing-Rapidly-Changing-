# QueryGuard Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=queryguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Detector Thresholds (Configurable)
THRESHOLD_WARNING_PCT=20.0
THRESHOLD_HIGH_PCT=50.0
THRESHOLD_CRITICAL_PCT=100.0
THRESHOLD_PERSISTENCE_WINDOWS=3
CARDINALITY_ERROR_THRESHOLD=2.0

# Hybrid Scoring Weights (Sum to 100)
WEIGHT_LATENCY=35.0
WEIGHT_PLAN=30.0
WEIGHT_CARDINALITY=15.0
WEIGHT_INDEX=10.0
WEIGHT_RELEASE_WORKLOAD=10.0

# Event Pipeline Reliability
MAX_ALLOWED_LATENESS_SECONDS=60.0
DEDUPLICATION_WINDOW_SIZE=10000

# Backend & Streamlit Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
STREAMLIT_PORT=8501
